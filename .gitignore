# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — never commit secrets; the documented template is the exception
.env*
!.env.example

# python / ML
ml/.venv/
__pycache__/
*.pyc
ml/models/*.joblib
ml/datasets/private/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# e2e auth state
/tests/e2e/.auth/
/playwright-report/
/test-results/

# macOS app build outputs
/macos/build/
/macos/ScamShield/.build/
/macos/ScamShield/.swiftpm/

# local stack runtime
/.scamshield-run/
# ML: generated artifacts (regenerate with npm run ml:train)
/ml/datasets/processed/
/ml/datasets/raw/external/
/ml/models/*.joblib
.pytest_cache/

# Model registry: candidates, releases and backups are build artefacts (large files).
/ml/registry/candidates/
/ml/registry/releases/
/ml/registry/backups/
/ml/datasets/raw/contributions/
/ml/datasets/review/

# Release audit 2026-10-11
# A separate, unrelated project (its own .env, .venv and Git) lives in db/ — never part of ScamShield.
/db/
# Development app build (self-test / previews) — never shipped.
/macos/ScamShield/.build-dev/
# The model-signing PUBLIC key must ship (clients verify updates with it); private keys never live here.
!/ml/registry/model-signing-public.pem
