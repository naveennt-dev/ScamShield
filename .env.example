# ============================================================================
# ScamShield environment variables. Copy to `.env` (never commit `.env`).
# Server-only: none of these are exposed to the browser (no NEXT_PUBLIC_ vars).
# ============================================================================

# ---- Core ---------------------------------------------------------------------
# PostgreSQL connection string (required for auth, history, reports).
DATABASE_URL=postgresql://scamshield:scamshield@localhost:5432/scamshield
# Public base URL of the app (used for OAuth callbacks, CORS and CSP decisions).
BETTER_AUTH_URL=http://localhost:3000
# Optional alias used for OpenRouter attribution headers; defaults to BETTER_AUTH_URL.
APP_URL=
APP_VERSION=1.0.0

# ---- Authentication (better-auth) -------------------------------------------------
# 32+ random characters: `openssl rand -base64 32`
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Email/password sign-in for LOCAL DEVELOPMENT AND E2E TESTS ONLY.
AUTH_ENABLE_EMAIL_PASSWORD=false

# ---- OpenRouter (LLM) -------------------------------------------------------------
# Leave empty to run in deterministic mode (rules + ML + URL analysis only).
# ---- Optional remote AI (Phase 4) — OFF by default ---------------------------------------
# Remote analysis needs ALL of: LLM_ENABLED=true, a key, a free model, AND a client that asks for
# it on that scan (Mac: Settings → Analysis → "On this Mac + remote AI"; web: the per-scan box).
# Never commit a real key. Leave empty for local-only use.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Model ids are configuration (no code change). Only ":free" models whose OpenRouter catalogue
# price is 0 are ever called; there is no paid fallback. Free availability changes — check
# https://openrouter.ai/models?max_price=0 . Verified free on 2026-10-10:
#   google/gemma-4-31b-it:free  ·  nvidia/nemotron-3-super-120b-a12b:free
SCAM_PRIMARY_MODEL=
SCAM_FALLBACK_MODEL=
SCAM_FAST_MODEL=
OPENROUTER_REQUIRE_FREE_MODELS=true
# Bounded, interactive budgets (the Mac app waits for the result; it falls back to local after).
# Free "reasoning" models need ~6–12 s and ~840 tokens for one analysis (measured 2026-10-10).
OPENROUTER_TIMEOUT_MS=20000
OPENROUTER_MAX_RETRIES=1
OPENROUTER_TOTAL_BUDGET_MS=25000
OPENROUTER_MAX_TOKENS=1500
# Most characters of minimised text sent per analysis.
OPENROUTER_MAX_INPUT_CHARS=3000
LLM_ENABLED=false

# ---- ML (local) ------------------------------------------------------------------------
ML_ENABLED=true
# auto = Python service with embedded fallback · service · embedded
ML_BACKEND=auto
# Must be loopback. Start with: npm run ml:service  (or scripts/local-stack.sh start)
ML_SERVICE_URL=http://127.0.0.1:8765
ML_SERVICE_TIMEOUT_MS=1500
# Portable model used by the embedded fallback
ML_MODEL_PATH=ml/models/scam_classifier.json

# ---- Risk fusion weights (relative; renormalised over available detectors) ----------
RISK_WEIGHT_ML=0.35
RISK_WEIGHT_RULES=0.30
RISK_WEIGHT_URL=0.20
RISK_WEIGHT_LLM=0.15
# Score ≥ threshold ⇒ level (starting points; calibrate on validation data)
RISK_THRESHOLD_SUSPICIOUS=30
RISK_THRESHOLD_HIGH=60
RISK_THRESHOLD_CRITICAL=85
# Model-only evidence (no rule, no risky link) can raise a result to SUSPICIOUS at most
RISK_CAP_UNCORROBORATED_ML=true

# ---- Input limits -----------------------------------------------------------------------
MAX_MESSAGE_LENGTH=10000
MAX_BODY_BYTES=65536
MAX_IMAGE_BYTES=5242880

# ---- Rate limiting -------------------------------------------------------------------------
# REQUIRED IN PRODUCTION. Without it, limits are in-memory per instance (dev only).
REDIS_URL=
RATE_LIMIT_ENABLED=true
ALLOW_ANONYMOUS_ANALYSIS=true
# Opt-in shared-learning contributions (POST /api/v1/contributions). scripts/local-stack.sh sets it
# to true for the personal local API (contributions then stay in this Mac's database).
CONTRIBUTIONS_ENABLED=false
# Link scanning (docs/design/link-protection.md). URL threat feeds are used only with a key; each
# receives scheme://host/path of scanned links (online mode only). Check each service's terms.
# URLHAUS_AUTH_KEY=
# PHISHTANK_APP_KEY=
# Isolated page-behaviour inspection (explicit click per scan). OFF by default — not VM-isolated
# (docs/design/link-protection.md §4). local-stack.sh enables it only with SCAMSHIELD_DYNAMIC_INSPECTION=1.
DYNAMIC_INSPECTION_ENABLED=false
DYNAMIC_INSPECTION_TIMEOUT_MS=20000
# Let the local Chromium extension call /api/v1/analyze/link (loopback only). Set by local-stack.sh.
ALLOW_BROWSER_EXTENSION=false
# Model registry (scripts/model-registry.ts). Defaults: private key in
# ~/Library/Application Support/ScamShield/keys/model-signing-ed25519.pem (never in the repo),
# pinned public key ml/registry/model-signing-public.pem.
# MODEL_SIGNING_KEY_PATH=
# MODEL_UPDATE_PUBLIC_KEY_PATH=
# Trust X-Forwarded-For / X-Real-IP (true on Vercel or behind your own proxy; false if exposed directly).
TRUST_PROXY_HEADERS=true

# ---- CORS -----------------------------------------------------------------------------------
# Comma-separated exact origins allowed to call the API cross-origin. No wildcards.
CORS_ALLOWED_ORIGINS=

# ---- URL redirect resolution (SSRF-guarded server-side fetch) -------------------------------
URL_FETCH_ENABLED=false
URL_FETCH_TIMEOUT_MS=5000
URL_FETCH_MAX_REDIRECTS=5
URL_FETCH_MAX_BYTES=262144

# ---- OCR ---------------------------------------------------------------------------------------
# tesseract | disabled
OCR_PROVIDER=tesseract
OCR_TIMEOUT_MS=20000
# Optional self-hosted tesseract language data (otherwise fetched once from the tesseract.js CDN).
OCR_TESSERACT_LANG_PATH=

# ---- Privacy / retention -------------------------------------------------------------------------
DEFAULT_RETENTION_DAYS=90
EVENT_RETENTION_DAYS=30
# Bearer token for GET /api/v1/cron/retention (Vercel Cron sends it automatically).
CRON_SECRET=

# ---- Local-only operation ------------------------------------------------------------------------
NEXT_TELEMETRY_DISABLED=1

# ---- Observability ------------------------------------------------------------------------------------
LOG_LEVEL=info
# Enables GET /api/v1/metrics (Prometheus) with `Authorization: Bearer <token>`.
METRICS_TOKEN=
# Integration point only; see src/lib/observability/error-reporting.ts.
SENTRY_DSN=

# ---- Tests ---------------------------------------------------------------------------------------------
# Disposable database for integration/E2E tests (migrations are applied automatically).
TEST_DATABASE_URL=
# Optional Redis for the Redis rate-limit integration test (use a disposable DB index).
TEST_REDIS_URL=
