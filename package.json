{
  "name": "scam-shield",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit tests/security",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "ml:train": "SCAMSHIELD_MODEL_OUT=ml/registry/candidates/next ml/.venv/bin/python ml/training/preprocess.py && SCAMSHIELD_MODEL_OUT=ml/registry/candidates/next ml/.venv/bin/python ml/training/train.py && SCAMSHIELD_MODEL_OUT=ml/registry/candidates/next ml/.venv/bin/python ml/training/evaluate.py",
    "ml:evaluate": "ml/.venv/bin/python ml/training/evaluate.py && tsx scripts/evaluate-system.ts",
    "ml:parity-fixture": "ml/.venv/bin/python ml/inference/predict.py --fixture src/lib/detection/ml/__fixtures__/parity.json",
    "postinstall": "prisma generate",
    "ml:fetch-data": "mkdir -p ml/datasets/raw/external && curl -sSL -o ml/datasets/raw/external/smsspamcollection.zip https://archive.ics.uci.edu/static/public/228/sms+spam+collection.zip && unzip -o -q ml/datasets/raw/external/smsspamcollection.zip -d ml/datasets/raw/external",
    "ml:preprocess": "ml/.venv/bin/python ml/training/preprocess.py",
    "ml:test": "ml/.venv/bin/python -m pytest -q ml/tests",
    "ml:service": "ML_SERVICE_HOST=127.0.0.1 ml/.venv/bin/python ml/inference/service.py",
    "start:local": "scripts/local-stack.sh start",
    "stop:local": "scripts/local-stack.sh stop",
    "intel:import": "tsx --env-file=.env scripts/intel-import.ts",
    "intel:prune": "tsx --env-file=.env scripts/intel-import.ts --prune-expired",
    "db:verify-migrations": "bash scripts/verify-migrations.sh",
    "model:registry": "tsx --env-file-if-exists=.env scripts/model-registry.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@radix-ui/react-avatar": "^1.1.3",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-popover": "^1.1.6",
    "@radix-ui/react-scroll-area": "^1.2.3",
    "@radix-ui/react-separator": "^1.1.2",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-tooltip": "^1.1.8",
    "@tanstack/react-query": "^5.69.0",
    "better-auth": "^1.7.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "ioredis": "^6.0.0",
    "lucide-react": "^0.483.0",
    "next": "^15.5.27",
    "next-themes": "^0.4.6",
    "react": "^19.3.0",
    "react-circular-progressbar": "^2.2.0",
    "react-dom": "^19.3.0",
    "react-icons": "^5.5.0",
    "sonner": "^2.0.1",
    "tailwind-merge": "^3.0.2",
    "tesseract.js": "^7.0.0",
    "tldts": "^7.4.16",
    "tw-animate-css": "^1.2.4",
    "vaul": "^1.1.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.27",
    "prettier": "^3.5.3",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=20.11"
  }
}
